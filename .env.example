# Dikonfigurasi dengan python scripts/setup_admin.py
ADMIN_PASSWORD_HASH=
COOKIE_SECURE=false
# Lokal menggunakan SQLite jika DATABASE_URL tidak diisi.
# Hosting dapat menggunakan postgresql+psycopg://user:password@host:5432/keputih
# DATABASE_URL=
# DATA_DIR=
# Tile XYZ lokal: /tiles/{z}/{x}/{y}.png
ORTHOPHOTO_TILE_URL=
# Opsional: Python terpisah yang memiliki osgeo.GDAL dengan driver ECW.
# Contoh Windows: C:\OSGeo4W\bin\python3.exe (jika driver ECW tersedia).
# RASTER_PYTHON=
